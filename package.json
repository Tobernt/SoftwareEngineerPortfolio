{
  "name": "tobias-berntsson-software-engineer-portfolio",
  "version": "1.0.0",
  "description": "Software engineering portfolio with accessible English and Swedish content.",
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tailwindcss -i ./src/styles/tailwind.css -o ./assets/styles.css --watch",
    "build": "npm run build:css && npm run build:react-demo",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./assets/styles.css --minify",
    "build:react-demo": "npm run build --prefix react-demo",
    "serve:test": "http-server -p 4173 .",
    "build:site": "npm run build && node scripts/package-site.cjs",
    "validate:html": "html-validate index.html gallery.html",
    "test:browser": "playwright test",
    "build:offline": "npm run build:css && node scripts/package-offline.cjs",
    "package:offline": "npm run build:css && node scripts/package-offline.cjs --zip",
    "start:studio": "node OfflineStyleStudio/server.mjs --open",
    "test:studio": "playwright test --config=playwright.studio.config.cjs",
    "validate:studio": "html-validate studio/index.html"
  },
  "keywords": [
    "tailwind",
    "portfolio"
  ],
  "author": "Tobias Berntsson",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.9.0",
    "autoprefixer": "^10.4.20",
    "html-validate": "^11.21.0",
    "http-server": "^14.1.1",
    "lighthouse": "^13.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10"
  }
}
